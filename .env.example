# Copy to .env — Supabase project (EU region).
# URL: Settings → Data API → Project URL.
# Key: Settings → API Keys → Publishable key (sb_publishable_...). Safe to ship
# in the client bundle; gated by RLS + the upsert_participant RPC.
# NEVER put the secret key (sb_secret_...) here or anywhere in the app.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
